public class SumOddNumbers {
    public static void main(String[] args) {
        int n = 20;   // you can change n
        int sum = 0;
        int i = 1;

        while (i <= n) {
            if (i % 2 != 0) {
                sum = sum + i;
            }
            i++;
        }

        System.out.println("Sum of odd numbers up to " + n + " = " + sum);
    }
}
output
Sum of odd numbers up to 20 = 100
