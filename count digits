import java.util.Scanner;
public class count{
public static void main(String [] args)
{
Scanner sc=new Scanner(System.in);
  int num,count=0;
  System.out.println("Enter the number");
num=sc.nextInt();
while(num>0){
count++;
num=num/10;
}
System.out.println("digits="+count);
}
}
